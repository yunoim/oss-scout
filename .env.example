# GitHub: in Actions the default GITHUB_TOKEN is enough (search 30 req/min, core 1000-5000/h).
# Locally use a PAT (public_repo read is enough).
GITHUB_TOKEN=

# Notion: either an existing database id, or a parent page id to auto-create "OSS Scout" DB under.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PARENT_PAGE_ID=

# Gmail SMTP (STARTTLS 587) with an App Password (Google Account -> Security -> App passwords).
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_TO=

# Optional: owner/repo used to link the committed report in the mail (Actions sets GITHUB_REPOSITORY).
REPORT_REPOSITORY=

# Optional: Naver search mention counts for the "market" score. Without keys awareness is neutral.
# New keys: NAVER Cloud Platform -> NAVER API HUB -> Application (Search API). Free 775,000 calls/month.
NCP_APIGW_KEY_ID=
NCP_APIGW_KEY=
# Legacy developers.naver.com keys (issued before 2026-07-25 only; service ends 2027-06-30).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
